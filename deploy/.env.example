# Public hostname of the FRONTEND (no scheme, no port), added to Vite's allowedHosts
# e.g. HOST_URL=rsvp.example.com
HOST_URL=localhost

# Database Configuration
DB_HOST=db
# Replace every CHANGE_ME value before deploying (WordPress admin is public)
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGE_ME_db_password

# WordPress Admin Credentials (for automatic installation)
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=CHANGE_ME_admin_password
# Only used at the first install (later: wp-admin -> Settings -> General).
# Also receives the RSVP digest, unless recipients are set in wp-admin -> Wedding -> Emails
WORDPRESS_ADMIN_EMAIL=admin@example.com
WORDPRESS_SITE_TITLE=Headless WordPress

# New RSVPs are emailed to the hosts once a night, as one digest
# Hour 0-23 in the WordPress timezone (Settings > General, UTC by default)
# WEDDING_DIGEST_HOUR=2

# SMTP for the digest emails sent to the hosts
# (the WordPress image cannot send mail without it)
# e.g. Gmail: smtp.gmail.com, 587, tls, your address + an app password
# WEDDING_SMTP_HOST=smtp.gmail.com
# WEDDING_SMTP_PORT=587
# WEDDING_SMTP_SECURE=tls   # tls (587), ssl (465) or none
# WEDDING_SMTP_USER=you@gmail.com
# WEDDING_SMTP_PASS=CHANGE_ME_smtp_password
# WEDDING_SMTP_FROM=you@gmail.com   # default: WEDDING_SMTP_USER
# Origin of the frontend as seen by the browser (no path)
# e.g. WORDPRESS_CORS_ORIGINS=https://rsvp.example.com
WORDPRESS_CORS_ORIGINS=http://localhost:5173

# Optional: Enable GraphQL plugin (default: false)
# WORDPRESS_ENABLE_GRAPHQL=true

# WordPress Configuration (public URL of WordPress, no port behind a tunnel)
# e.g. WP_HOME=https://wp-rsvp.example.com
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# Frontend Configuration (API URL as seen from the browser)
# e.g. VITE_API_BASE=https://wp-rsvp.example.com/wp-json/wedding/v1
# Recreate the frontend after changing it: docker compose up -d --force-recreate frontend
VITE_API_BASE=http://localhost:8080/wp-json/wedding/v1
# VITE_WP_GRAPHQL_URL=http://localhost:8080/graphql  # Only if WORDPRESS_ENABLE_GRAPHQL=true

# Ports are fixed in docker-compose.yml: frontend 5173, WordPress 8080,
# phpMyAdmin 127.0.0.1:8081, MySQL not published.
